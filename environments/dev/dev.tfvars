# ==============================================================================
# dev.tfvars — Variable values for the DEV environment
# Usage: terraform apply -var-file="dev.tfvars"
#
# PASSWORDS: No password here! The secrets_manager module auto-generates and
#            stores the RDS password in AWS Secrets Manager.
# ==============================================================================

environment = "dev"
aws_region  = "us-east-1"

# Networking
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

# Compute
key_name       = "devops"
instance_type  = "t3.medium"
instance_count = 1

# EKS
kubernetes_version = "1.29"
node_instance_type = "t3.medium"
node_desired_count = 2
node_min_count     = 1
node_max_count     = 3

# RDS — password is auto-generated by secrets_manager module
db_username       = "admin"
db_instance_class = "db.t3.micro"
replica_count     = 1

# Storage
bucket_name_prefix = "terraform-learning"

# SNS — add your email to receive CloudWatch alarm notifications
# Leave empty [] to create the topic without any subscribers
alert_email_addresses = []
# alert_email_addresses = ["you@example.com"]
